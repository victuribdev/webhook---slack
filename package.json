{
  "name": "slack-jibble-automation",
  "version": "1.0.0",
  "description": "Automação para fazer clock-in/clock-out no Jibble quando usuário entra/sai de canais do Slack",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "report": "node scripts/generate-report.js",
    "report:today": "node scripts/generate-report.js",
    "report:list": "node scripts/generate-report.js --list"
  },
  "keywords": [
    "slack",
    "jibble",
    "webhook",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "crypto": "^1.0.1",
    "axios": "^1.6.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}